# Application environment: development | test | production
APP_ENV=development

# Docker Compose only: credentials and database name of the Postgres container.
# Compose also uses these to build the api's Postgres URL (host "db").
POSTGRES_USER=leadflow
POSTGRES_PASSWORD=leadflow
POSTGRES_DB=leadflow

# Manual (non-Docker) backend runs only. Docker Compose ignores this value and
# builds its own Postgres URL from the POSTGRES_* variables above.
# Default: SQLite, zero setup.
DATABASE_URL=sqlite:///./leadflow.db
# To use a local Postgres instead:
# DATABASE_URL=postgresql+psycopg://leadflow:leadflow@localhost:5432/leadflow

# Comma-separated list of origins allowed by CORS (the frontend origin only)
BACKEND_CORS_ORIGINS=http://localhost:3000

# Base URL of the API as seen from the browser. Docker Compose bakes it into the
# web image at build time, so changing it requires `docker compose up --build`.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Docker Compose only: run `python seed.py` after migrations when the api starts
# (idempotent: it skips when leads already exist). true | false
SEED_ON_START=true
