# Application environment: development | test | production
APP_ENV=development

# Postgres superuser name created by the db container
POSTGRES_USER=leadflow

# Postgres password for POSTGRES_USER (change for any non-local use)
POSTGRES_PASSWORD=leadflow

# Postgres database name created by the db container
POSTGRES_DB=leadflow

# SQLAlchemy connection URL used by the API. Defaults to SQLite for zero-setup local runs.
# Postgres via Docker Compose:        postgresql+psycopg://leadflow:leadflow@db:5432/leadflow
# Postgres when running outside Docker: postgresql+psycopg://leadflow:leadflow@localhost:5432/leadflow
DATABASE_URL=sqlite:///./leadflow.db

# Comma-separated list of origins allowed by CORS (the frontend origin only)
BACKEND_CORS_ORIGINS=http://localhost:3000

# Base URL of the API as seen from the browser
NEXT_PUBLIC_API_URL=http://localhost:8000
